@startuml AlurMenuKonsol

skinparam ActivityBackgroundColor #EAF2FF
skinparam ActivityBorderColor #4A90D9
skinparam ArrowColor #4A90D9
skinparam ActivityDiamondBackgroundColor #FFF0F5
skinparam ActivityDiamondBorderColor #D94A8C

start

:CarSimulator.main();
:initializeCar();
:setupAutopilot();
:ConsoleUI.run();

repeat
  :displayMenu();
  note right
    [1] Status Mobil
    [2] Aktifkan Autopilot
    [3] Cruise Control
    [4] Matikan Autopilot
    [5] Keluar
  end note

  :processInput();

  if (input == 1?) then (ya)
    :Car.getStatus();
    :displayStatus();
  elseif (input == 2?) then (ya)
    :Car.enableAutopilot();
    :AutopilotSystem.activate();
    :displayAlert("Autopilot Aktif");
  elseif (input == 3?) then (ya)
    :Input target speed;
    :AutopilotSystem.setCruiseSpeed(speed);
    :displayAlert("Cruise Control Aktif");
  elseif (input == 4?) then (ya)
    :Car.disableAutopilot();
    :AutopilotSystem.deactivate();
    :displayAlert("Autopilot Nonaktif");
  elseif (input == 5?) then (ya)
    :displayAlert("Keluar...");
    stop
  else (tidak valid)
    :displayAlert("Input tidak valid");
  endif

repeat while (program berjalan?) is (ya)
->tidak;

stop

@enduml