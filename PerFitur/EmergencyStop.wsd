@startuml EmergencyStop

skinparam ActivityBackgroundColor #FFF0F0
skinparam ActivityBorderColor #D94A4A
skinparam ArrowColor #D94A4A
skinparam ActivityDiamondBackgroundColor #FFF0F5
skinparam ActivityDiamondBorderColor #D94A8C

start

if (Pemicu Emergency Stop?) then
  split
    :ObjectDetector.isObstacleAhead()\ndistance <= minSafeDistance;
  split again
    :ObjectType == PEDESTRIAN\natau UNKNOWN;
  split again
    :User input manual\nMANUAL_OVERRIDE;
  split again
    :SpeedSensor.isOverLimit()\n== true;
  end split
endif

:set mode = EMERGENCY_STOP;
:displayAlert("EMERGENCY STOP DIAKTIFKAN!");

fork
  :Brake.emergencyBrake();
fork again
  :Engine.brake();
fork again
  :GearBox.shiftDown() bertahap;
end fork

:SpeedSensor.getSpeed() → currentSpeed;

repeat
  :Monitor currentSpeed;
  if (currentSpeed > 0?) then (ya)
    :Brake.emergencyBrake() lanjut;
  endif
repeat while (currentSpeed > 0?) is (ya)
-> tidak;

:Car.stop();
:currentSpeed = 0;

:AutopilotSystem.deactivate();
:set mode = MANUAL_OVERRIDE;
:set isActive = false;

:displayAlert("Kendaraan berhenti total.\nSilakan periksa kondisi sekitar.");

if (User konfirmasi lanjut?) then (ya)
  :Car.enableAutopilot();
  :AutopilotSystem.activate();
  :set mode = CRUISE_CONTROL;
  :Kembali ke operasi normal;
else (tidak)
  :Sistem tetap\ndalam MANUAL_OVERRIDE;
  stop
endif

stop

@enduml