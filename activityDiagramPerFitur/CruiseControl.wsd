@startuml CruiseControl

skinparam ActivityBackgroundColor #F0EEFF
skinparam ActivityBorderColor #7A60D9
skinparam ArrowColor #7A60D9
skinparam ActivityDiamondBackgroundColor #FFF0F5
skinparam ActivityDiamondBorderColor #D94A8C

start

if (Autopilot baru diaktifkan?) then (ya)
  :Car.enableAutopilot();
  :AutopilotSystem.activate();
  :targetSpeed = DEFAULT_CRUISE_SPEED 50 KM/Jam;
  :SpeedSensor.setCurrentSpeed(Car.currentSpeed);
  :ObjectDetector.initialize();
  :SpeedSensor.initialize();
  :mode = CRUISE_CONTROL;
else (Set Cruise Control)
  :User input target speed;
  :AutopilotSystem.setCruiseSpeed(speed);
  :mode = CRUISE_CONTROL;
endif

repeat
  :AutopilotSystem.update();
  :scanForObstacles = shouldRunNormalDetection();
  note right
    Deteksi normal berjalan jarang
    memakai NORMAL_DETECTION_CHANCE.
  end note

  :currentSpeed = SpeedSensor.readData();

  if (scanForObstacles?) then (ya)
    :ObjectDetector.readData();
  endif

  if (SpeedSensor.isOverLimit()?) then (ya)
    :mode = EMERGENCY_STOP;
    :gradualEmergencyStop();
    :AutopilotSystem.deactivate();
    stop
  endif

  if (mode == COLLISION_AVOIDANCE dan tidak scan?) then (ya)
    :Car.driveStraight();
    :mode = CRUISE_CONTROL;
  endif

  if (mode == CRUISE_CONTROL?) then (ya)
    if (currentSpeed == targetSpeed?) then (ya)
      :Kecepatan stabil;
    elseif (currentSpeed < targetSpeed?) then (ya)
      :Engine.accelerate();
      :SpeedSensor += 5 KM/Jam;
    else (currentSpeed > targetSpeed)
      :Brake.apply();
      :SpeedSensor -= 5 KM/Jam;
    endif
  endif

  if (scanForObstacles dan obstacle <= minSafeDistance?) then (ya)
    :handleObstacle();
  else (tidak)
    :adjustGear(scanForObstacles);
  endif

  :Car.setCurrentSpeed(autopilot speed);
  :FuelTank dikonsumsi saat mobil berjalan;

repeat while (autopilot.isActive()?) is (ya)
->tidak;

:Cruise control selesai atau autopilot nonaktif;
stop

@enduml
