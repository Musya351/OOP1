@startuml PerpindahanGigiOtomatis

skinparam ActivityBackgroundColor #F0FFF0
skinparam ActivityBorderColor #4A9D4A
skinparam ArrowColor #4A9D4A
skinparam ActivityDiamondBackgroundColor #FFF0F5
skinparam ActivityDiamondBorderColor #D94A8C

start

:AutopilotSystem.adjustGear();
:SpeedSensor.getSpeed() → currentSpeed;
:SpeedSensor.getOptimalGear() → optimalGear;
:GearBox.currentGear → currentGear;

if (GearBoxType.isAutomatic == true?) then (tidak)
  :displayAlert("Transmisi manual\ntidak bisa auto-shift");
  stop
endif

if (optimalGear == currentGear?) then (ya)
  :Gigi sudah optimal\ntidak ada perubahan;
  stop
endif

if (optimalGear > currentGear?) then (ya)

  repeat
    :GearBox.shiftUp();
    :currentGear + 1;
    :SpeedSensor.getSpeed() → currentSpeed;
    :SpeedSensor.getOptimalGear() → optimalGear;

    if (ObjectDetector.isObstacleAhead()?) then (ya)
      :Batalkan shift up;
      :set mode = COLLISION_AVOIDANCE;
      stop
    endif

  repeat while (currentGear < optimalGear?) is (ya)
  -> tidak;

else (optimalGear < currentGear)

  repeat
    :GearBox.shiftDown();
    :currentGear - 1;
    :SpeedSensor.getSpeed() → currentSpeed;
    :SpeedSensor.getOptimalGear() → optimalGear;

    if (currentSpeed == 0?) then (ya)
      :GearBox.shiftDown() ke gigi 1;
      :Car.stop();
      stop
    endif

  repeat while (currentGear > optimalGear?) is (ya)
  -> tidak;

endif

:GearBox.autoShift(currentSpeed);
:displayAlert("Gigi sekarang: " + currentGear);

if (mode == CRUISE_CONTROL?) then (ya)
  :SpeedSensor.maintainSpeed(targetSpeed);
  :Kembali ke loop Cruise Control;
elseif (mode == COLLISION_AVOIDANCE?) then (ya)
  :Kembali ke loop Collision Avoidance;
else (MANUAL_OVERRIDE)
  :Serahkan kendali ke user;
endif

stop

@enduml