@startuml DeteksiObjekCollisionAvoidance

skinparam ActivityBackgroundColor #EAF2FF
skinparam ActivityBorderColor #4A90D9
skinparam ArrowColor #4A90D9
skinparam ActivityDiamondBackgroundColor #FFF0F5
skinparam ActivityDiamondBorderColor #D94A8C

start

:AutopilotSystem.update();
:ObjectDetector.initialize();

if (ObjectDetector.isReady()?) then (tidak)
  :displayAlert("Sensor tidak siap!");
  stop
endif

repeat

  :ObjectDetector.scan() → List<DetectedObject>;

  if (List kosong?) then (ya)
    :Tidak ada objek terdeteksi;
    :Lanjut berkendara normal;
  else (tidak)
    :ObjectDetector.getNearestObject();
    :ObjectDetector.getDistance() → distance;

    if (distance <= minSafeDistance?) then (ya)

      if (DetectedObject.isThreat == true?) then (ya)

        if (ObjectType == PEDESTRIAN?) then (ya)
          :set mode = EMERGENCY_STOP;
          :Brake.emergencyBrake();
          :displayAlert("Pejalan kaki terdeteksi!");
          stop
        elseif (ObjectType == VEHICLE?) then (ya)
          :set mode = COLLISION_AVOIDANCE;
          :Brake.apply();
          :Car.turnLeft() atau turnRight();
          :displayAlert("Kendaraan di depan!");
        elseif (ObjectType == OBSTACLE?) then (ya)
          :set mode = COLLISION_AVOIDANCE;
          :Brake.apply();
          :Car.turnLeft() atau turnRight();
          :displayAlert("Rintangan terdeteksi!");
        elseif (ObjectType == TRAFFIC_SIGN?) then (ya)
          :Baca rambu;
          :Sesuaikan kecepatan;
        else (UNKNOWN)
          :set mode = EMERGENCY_STOP;
          :Brake.emergencyBrake();
          :displayAlert("Objek tidak dikenal!");
          stop
        endif

      else (tidak)
        :Objek tidak berbahaya;
        :Lanjut berkendara;
      endif

    else (distance > minSafeDistance)
      :Jarak aman\nLanjut berkendara normal;
    endif

  endif

repeat while (AutopilotSystem.isActive?) is (ya)
-> tidak;

:Deteksi objek selesai;
stop

@enduml